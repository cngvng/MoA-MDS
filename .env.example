OPENAI_API_KEY=your_openai_api_key_here

# Optional OpenAI-compatible self-hosted endpoint.
# Set these in configs/agents/default.yaml or configs/base.yaml:
# llm.model_id: "your-model-name"
# llm.base_url: "http://localhost:8000/v1"
# llm.api_key_env: "OPENAI_API_KEY"
#
# For Ollama OpenAI-compatible API, a typical base URL is:
# http://localhost:11434/v1
#
# For vLLM OpenAI-compatible server, a typical base URL is:
# http://localhost:8000/v1
